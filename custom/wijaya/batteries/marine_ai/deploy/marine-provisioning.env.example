# Example NON-SECRET environment for the Marine provisioning overlay.
# Copy to a local .env consumed by docker compose. NEVER put the actual superuser
# password here — it is delivered only via the read-only secret file below.

# PostgreSQL cluster the provisioner connects to as the existing superuser.
MARINE_PROVISIONING_PG_HOST=postgres
MARINE_PROVISIONING_PG_PORT=5432

# Admin role used ONLY for CREATE DATABASE / CREATE ROLE. This is the EXISTING
# PostgreSQL superuser username your deployment already uses (POSTGRES_USERNAME);
# no separate bootstrap account is required. This is a username, not a password.
MARINE_PROVISIONING_PG_ADMIN_USER=postgres

# Maintenance DB to attach to for cluster-level DDL (default: postgres).
MARINE_PROVISIONING_PG_MAINTENANCE_DB=postgres

# SSL mode for the provisioning connection (disable | allow | prefer | require |
# verify-ca | verify-full). Set this to match your cluster; many single-host
# deployments use `disable`.
MARINE_PROVISIONING_PG_SSLMODE=prefer

# Host path to the file holding the EXISTING superuser password. This file must
# exist on the host / secret store and MUST NOT be committed. The container sees it
# at /run/secrets/marine_provisioning_pg_password (read-only, mode 0400).
MARINE_PROVISIONING_PG_PASSWORD_FILE_HOST=/srv/secrets/marine_provisioning_pg_password
